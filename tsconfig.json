{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@app-types/*": ["./src/types/*"],
      "@components/*": ["./src/components/*"],
      "@hooks": ["./src/hooks"],
      "@hooks/*": ["./src/hooks/*"],
      "@lib/*": ["./src/lib/*"],
      "@notifications/*": ["./src/notifications/*"],
      "@auth/*": ["./src/features/auth/*"],
      "@profile/*": ["./src/features/profile/*"],
      "@programs/*": ["./src/features/programs/*"],
      "@courses/*": ["./src/features/courses/*"],
      "@lessons/*": ["./src/features/lessons/*"],
      "@quizzes/*": ["./src/features/quizzes/*"],
      "@attendance/*": ["./src/features/attendance/*"],
      "@students/*": ["./src/features/students/*"],
      "@certificates/*": ["./src/features/certificates/*"],
      "@payments/*": ["./src/features/payments/*"],
      "@audit-log/*": ["./src/features/audit-log/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
